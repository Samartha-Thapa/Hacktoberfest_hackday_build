APP_NAME=Talkie Mail
APP_ENV=development
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_COOKIE_SECURE=false
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_CPP_MODEL=gemma
LLAMA_CPP_TIMEOUT=60
LLAMA_CPP_CONTEXT_SIZE=2048
LLAMA_CPP_MAX_TOKENS=600
REDIS_URL=
REDIS_SUMMARY_CACHE_TTL=86400
REDIS_SOCKET_TIMEOUT=0.25
REDIS_CONNECT_TIMEOUT=0.25
SESSION_MAX_AGE=3600
OAUTH_STATE_MAX_AGE=600
